<Window x:Class="_20260218_WpfApp1.View.MaintenanceHistory"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:_20260218_WpfApp1"
        mc:Ignorable="d"
        Title="Maintenance" WindowStartupLocation="CenterScreen" Foreground="White">
    <ScrollViewer VerticalScrollBarVisibility="Visible">
        <Viewbox Stretch="Uniform">
            <Grid Background="#FF672121" Height="1080" Width="1920">
                <StackPanel Orientation="Vertical">
                    <StackPanel Orientation="Horizontal">
                        <Border Style="{StaticResource MajorButtonBorder}">
                            <Button 
                            Content="BACK TO MAIN MENU" 
                            Style="{StaticResource MajorButton}" 
                            Command="{Binding BackCommand}"
                            />
                        </Border>
                        <TextBlock Text="CAR RENTAL SYSTEM" Foreground="White" Style="{StaticResource Title}" Margin="25,40,25,40"/>
                    </StackPanel>
                    <Border Style="{StaticResource MainBorder}"/>
                    <StackPanel HorizontalAlignment="Center" Margin="25,40,25,40">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <StackPanel Grid.Row="2" VerticalAlignment="Center" HorizontalAlignment="Center">
                                <TextBlock Text="MAINTENANCE HISTORY" HorizontalAlignment="Center" Style="{StaticResource Header}"/>
                                <TextBlock Text="{Binding History}" Style="{StaticResource BodyTextStyle}"/>
                                <TextBlock Text="PLATE NUMBER" HorizontalAlignment="Center" VerticalAlignment="Top" Foreground="White" Style="{StaticResource BodyTextStyle}"/>
                                <Border Style="{StaticResource TextBoxBorder}">
                                    <TextBox 
                                        Width="200" 
                                        Style="{StaticResource BodyTextBox}"
                                        Text="{Binding PlateNumber, UpdateSourceTrigger=PropertyChanged}"
                                    />
                                </Border>
                                <Border Style="{StaticResource NormalButtonBorder}">
                                    <Button Content="Search" Style="{StaticResource NormalButton}" Command="{Binding SearchCommand}"/>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Viewbox>
    </ScrollViewer>
</Window>
