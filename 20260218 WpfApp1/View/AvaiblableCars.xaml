<Window x:Class="_20260218_WpfApp1.View.AvailableCars"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:_20260218_WpfApp1"
        mc:Ignorable="d"
        Title="Avaiblable Cars" WindowStartupLocation="CenterScreen" Foreground="White">
    <ScrollViewer VerticalScrollBarVisibility="Visible">
        <Viewbox Stretch="Uniform">
            <Grid Background="#FF672121" Height="1080" Width="1920">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <!-- Title -->
                    <RowDefinition Height="Auto"/>
                    <!-- Border -->
                    <RowDefinition Height="*"/>
                    <!-- Main Menu fills remaining space -->
                </Grid.RowDefinitions>

                <TextBlock Text="CAR RENTAL SYSTEM" Foreground="White" Style="{StaticResource Title}" Grid.Row="0" Margin="25,40,25,40"/>
                <Border Style="{StaticResource MainBorder}" Grid.Row="1"/>

                <StackPanel Grid.Row="2" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="AVAILABLE CARS" HorizontalAlignment="Center" Style="{StaticResource Header}"/>
                    <DataGrid 
                        ItemsSource="{Binding carsAvailable}"
                        AutoGenerateColumns="False"
                        CanUserAddRows="False"
                        Style="{StaticResource DataGridText}"
                        AlternatingRowBackground="LightBlue">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Name" Binding="{Binding Car.Name}" HeaderStyle="{StaticResource DataGridHeader}"/>
                            <DataGridTextColumn Header="Brand" Binding="{Binding Car.Brand}" HeaderStyle="{StaticResource DataGridHeader}"/>
                            <DataGridTextColumn Header="Age" Binding="{Binding Car.Age}" HeaderStyle="{StaticResource DataGridHeader}"/>
                            <DataGridTextColumn Header="License Plate" Binding="{Binding Car.LicensePlate}" HeaderStyle="{StaticResource DataGridHeader}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Grid>
        </Viewbox>
    </ScrollViewer>
</Window>
